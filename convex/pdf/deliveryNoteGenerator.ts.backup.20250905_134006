            text-align: right;
        }

        /* Customer name with Arabic support - EXACT SAME as quotation */
        .customer-name {
            font-weight: bold;
            margin-bottom: 5px;
        }

        .customer-name-arabic {
            direction: rtl;
            font-family: 'Noto Sans Arabic', Arial, sans-serif;
            font-size: 9px;
            color: #666;
        }

        /* Items table - EXACT SAME structure as quotation */
        .items-section {
            margin-bottom: 10px;
        }

        .items-table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 10px;
