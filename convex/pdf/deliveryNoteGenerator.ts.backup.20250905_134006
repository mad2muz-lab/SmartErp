                <div><strong>Delivery Date:</strong> ${deliveryNoteData.delivery_date}</div>
                <div><strong>Status:</strong> <span class="status-badge status-${getStatusBadgeClass(deliveryNoteData.status)}">${deliveryNoteData.status}</span></div>
