</html>`;

    return htmlContent;
  } catch (error) {
    console.error('❌ Error in generateDeliveryNoteHTML:', error);
    throw new Error(`HTML generation failed: ${error instanceof Error ? error.message : 'Unknown error'}`);
  }
}
