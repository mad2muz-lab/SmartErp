            background: white;
            box-sizing: border-box;
        }

        /* Professional letterhead header - EXACT SAME as quotation */
        .letterhead {
            border: ${borderWidth} ${borderStyle} ${primaryColor};
            border-top: none;
            padding: 8px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            min-height: 50px;
            background: white;
            margin-bottom: 20px;
        }

        /* Main content area - EXACT SAME as quotation */
        .main-content {
            margin-bottom: 20px;
        }

        /* Company info sections - EXACT SAME as quotation */
        .english-company {
            flex: 1;
            text-align: left;
            align-self: flex-start;
        }

        .center-logo {
            flex: 1;
            display: flex;
            justify-content: center;
            align-items: center;
            text-align: center;
            font-weight: bold;
            font-size: 16px;
        }

        .arabic-company {
            flex: 1;
            text-align: right;
            direction: rtl;
            font-family: 'Noto Sans Arabic', Arial, sans-serif;
            align-self: flex-start;
        }

        /* Delivery note title - SAME STRUCTURE as quotation title */
        .delivery-note-title {
            text-align: center;
            margin: 0 0 10px 0;
            padding: 8px;
            border: ${borderWidth} ${borderStyle} ${primaryColor};
            background-color: #f5f5f5;
        }

        .title {
            font-size: 14px;
            font-weight: bold;
            margin-bottom: 3px;
            color: ${primaryColor};
        }

        .arabic-title {
            font-size: 12px;
            font-weight: bold;
