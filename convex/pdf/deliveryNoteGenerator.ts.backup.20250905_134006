                <div class="customer-name"><strong>Customer:</strong> ${deliveryNoteData.customer_name}</div>
                ${deliveryNoteData.customer_name_arabic ? `<div class="customer-name-arabic">${deliveryNoteData.customer_name_arabic}</div>` : ''}
