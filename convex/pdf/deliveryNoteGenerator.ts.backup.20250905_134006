            <div class="footer-right">
                ${footerConfig.name_arabic ? `<div style="font-weight: bold; margin-bottom: 2px; direction: rtl; font-family: 'Noto Sans Arabic', Arial, sans-serif;">${organization.name_arabic || ''}</div>` : ''}
